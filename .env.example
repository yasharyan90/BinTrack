# =====================================================================
#  BinTrack — environment variables
#  Copy to web/.env.local (frontend) and supabase/.env.local (functions)
# =====================================================================

# ---------------------------------------------------------------------
# Frontend (web/.env.local) — Vite only exposes VITE_* to the browser
# ---------------------------------------------------------------------
# Local Supabase (supabase start): http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Anon key — safe to ship in the browser: every table is RLS-protected.
# Local default key is printed by `supabase start`.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional UI flags
VITE_APP_NAME=BinTrack
VITE_DEFAULT_WAREHOUSE=WH1

# ---------------------------------------------------------------------
# Edge Functions (supabase/.env.local — never committed, never in the browser)
# ---------------------------------------------------------------------
SUPABASE_URL=https://hmowcgbrhtpunjamsaik.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhtb3djZ2JyaHRwdW5qYW1zYWlrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1NDE0NTQsImV4cCI6MjEwNDExNzQ1NH0.5TY0kGRxJGnhLxJwK2VjrUp2nbda3eZXsR4IA32CKg4
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhtb3djZ2JyaHRwdW5qYW1zYWlrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODU0MTQ1NCwiZXhwIjoyMTA0MTE3NDU0fQ.MjxtmUrm54uawnPgSAlTryf3-SbxzymPMUJvNR2MlWc

# alert-digest (optional — function no-ops when unset)
RESEND_API_KEY=
ALERT_DIGEST_FROM=BinTrack <alerts@example.com>

# order-webhook (optional)
ORDER_WEBHOOK_SECRET=change-me
