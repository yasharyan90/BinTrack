{
  "compilerOptions": {
    "target": "ES2022",
    // Playwright's page.evaluate callbacks are authored here but execute in
    // the browser, so this project needs the DOM lib as well as Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "e2e"]
}
